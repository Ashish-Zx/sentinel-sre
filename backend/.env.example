# ---- Runtime / environment ----
APP_ENV=development            # development | production
LOG_LEVEL=INFO

# ---- Database (local Docker defaults) ----
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel

# ---- CORS (JSON array; localhost is always allowed) ----
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---- Clerk Auth (backend JWKS verification) ----
CLERK_JWKS_URL=
CLERK_ISSUER=

# ---- LLM providers (mercury-3 via Inception, or OpenAI/Anthropic) ----
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
LLM_MODEL=mercury-3
LLM_TEMPERATURE=0.75
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Cloud storage (Cloudflare R2 / S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=

# ---- MCP integrations: GitHub + Slack ----
# Global fallback token (optional if per-user OAuth is enabled below).
GITHUB_ACCESS_TOKEN=
GITHUB_DEFAULT_REPO=
SLACK_WEBHOOK_URL=

# ---- Per-user GitHub OAuth ----
# Create an OAuth App: https://github.com/settings/developers
# Callback URL must be `{BACKEND_URL}/api/github/callback`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional; defaults to `{BACKEND_URL}/api/github/callback` when unset.
GITHUB_OAUTH_CALLBACK_URL=
# Where the browser is redirected after connecting (your frontend).
FRONTEND_URL=http://localhost:3000
# Fernet key used to encrypt per-user GitHub tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Per-user Slack OAuth ----
# Create an app: https://api.slack.com/apps → OAuth & Permissions
# Bot Token Scope: chat:write, channels:read
# Callback URL must be `{BACKEND_URL}/api/slack/callback`.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional; defaults to `{BACKEND_URL}/api/slack/callback` when unset.
SLACK_OAUTH_CALLBACK_URL=

# ---- Optional rate limiting (Upstash Redis REST) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_RPM=120
